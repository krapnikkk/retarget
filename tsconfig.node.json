{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/node.tsbuildinfo"
  },
  "include": [
    "src/node.ts",
    "src/node-tooling/**/*.ts",
    "src/workers/node-tooling.worker.ts",
    "src/cli/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "references"]
}
